# PLANTILLA DE CONFIGURACIÓN Y VARIABLES DE ENTORNO
# Willys_IA: Regla de Oro #5 - CERO SECRETOS EN EL REPOSITORIO
# Copia este archivo a .env y define tus valores locales.
# NUNCA subas el archivo .env a Git.

APP_NAME="Calorías en Rutina - UAB 2026"
APP_ENV="development"
APP_DEBUG=True

# Seguridad de sesión (genera un valor aleatorio propio)
FLASK_SECRET_KEY="cambia-esta-clave-en-tu-entorno-local"

# Base de datos local (opcional: ruta explícita del archivo SQLite)
# DB_PATH="data/app.db"

# Rate limiting: auto (por defecto), memory o redis.
# Si Redis no está disponible, la aplicación cae a memoria de forma segura.
RATE_LIMIT_BACKEND="auto"
# REDIS_URL="redis://127.0.0.1:6379/0"

# Correo SMTP opcional. Si no se configura, los enlaces se imprimen en consola.
# No uses valores de ejemplo en producción: parecen placeholders y se ignoran.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# SMTP_FROM="no-reply@institucion.edu.bo"
SMTP_USE_TLS="true"

# Google Sign-In (opcional). Sin estos valores el botón queda desactivado.
# 1) Crea un proyecto en Google Cloud Console y habilita "Google Identity Services".
# 2) Crea credenciales OAuth de tipo "Aplicación web".
# 3) Agrega esta URI autorizada de redirección (ajusta IP/puerto si cambia):
#    http://127.0.0.1:5000/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
# Opcional: restringir a un dominio (ej. uab.edu.bo). Vacío = cualquier cuenta.
# GOOGLE_HD="uab.edu.bo"

# Parámetros del MVP
DEFAULT_CATEGORY="General"
